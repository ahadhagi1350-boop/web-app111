{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-app111",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "d4009e8e-5962-4741-a478-07b19f6c3df5","database_name": "web-app" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "25d730fc0d664a6884d177388106decf" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
